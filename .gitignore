# =========================================================
# VYRON FITNESS
# Git Ignore Configuration
# =========================================================


# =========================================================
# NODE.JS / NPM
# =========================================================

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

.npm/
.yarn/
.pnpm-store/

package-lock.json
yarn.lock
pnpm-lock.yaml


# =========================================================
# ENVIRONMENT VARIABLES / SECRETS
# =========================================================

.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local

# Keep an example configuration in Git
!.env.example


# =========================================================
# LOG FILES
# =========================================================

logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*


# =========================================================
# DATABASE / LOCAL DATA
# =========================================================

# PostgreSQL local/database dumps
*.sql
*.dump
*.backup
*.bak

# Local database files
*.db
*.sqlite
*.sqlite3

# PostgreSQL generated/local files
postgres-data/
postgresql-data/
pgdata/


# =========================================================
# BUILD / CACHE / TEMPORARY FILES
# =========================================================

dist/
build/
out/
.cache/
.parcel-cache/
.next/
.nuxt/
coverage/
.tmp/
temp/
tmp/

*.cache
*.tmp
*.temp


# =========================================================
# TESTING
# =========================================================

coverage/
.nyc_output/


# =========================================================
# IDE / EDITOR FILES
# =========================================================

.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

.idea/
*.iml

*.suo
*.user
*.userossc
*.sln.docstates


# =========================================================
# OPERATING SYSTEM FILES
# =========================================================

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
.directory


# =========================================================
# DEBUG / CRASH FILES
# =========================================================

*.stackdump
crash.log
crash-report.log


# =========================================================
# GENERATED FILES
# =========================================================

*.generated.*
*.map

# Temporary exports
exports/
generated/


# =========================================================
# UPLOADS / USER-GENERATED FILES
# =========================================================

# Ignore runtime uploads if they are generated by the server
uploads/*
!uploads/.gitkeep


# =========================================================
# JWT / AUTH / SECURITY
# =========================================================

*.pem
*.key
*.crt
*.cer
*.p12
*.pfx

# Private keys
private/
secrets/


# =========================================================
# LOCAL CONFIGURATION
# =========================================================

config.local.js
config.local.json
database.local.js
server.local.js


# =========================================================
# BACKUP FILES
# =========================================================

*.old
*.orig
*.backup
*.bak
*~
